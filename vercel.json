{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!api/|assets/|icons/|brand/|screenshots/|app\\.js$|sw\\.js$|workbox-|manifest\\.webmanifest$|favicon\\.|apple-touch-icon\\.png$|index\\.html$).+)",
      "has": [
        {
          "type": "host",
          "value": "debtbook-neon.vercel.app"
        }
      ],
      "destination": "https://bashibook.app/$1",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/?app=1#/privacy",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/kippa-alternative",
      "destination": "/kippa-alternative.html"
    },
    {
      "source": "/credit-book-app",
      "destination": "/credit-book-app.html"
    },
    {
      "source": "/ng/kippa-alternative",
      "destination": "/ng/kippa-alternative.html"
    },
    {
      "source": "/ng/credit-book-app",
      "destination": "/ng/credit-book-app.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Qqpy8XQ7hQ5Ti4VsdBEktKDt9RxBGVNAT4gpiiU4If4=' 'sha256-S4SGs1c/im4IZIhsFvXtW3s31pcCvUvsrEXqvkmMjrE=' 'sha256-cIMxXiJwBmAIlohaCffWQw1YUbq0pAWsEN/BVZw309A=' 'sha256-g+V5Z5rm9GmnhVfpXK9ux0y8IAoerAFpl3/rnUlAPVI=' 'sha256-i+vxzEPVxRlotY9G00HYGC4UmBZYL0sgLRevePOdg2Y=' 'sha256-jDpCxcNpC4V2G915EG9m35ecFd41ppcCWjhUdHnrYhM=' 'sha256-pYDJ+Hlb8XXSgEIPCgXngdHG1xD+pT7AlC5Vbe6yVVY=' 'sha256-zkK1s5MkAk+a7mt9EBToQGmQXaBCu1Qar7DGdOstAfw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://api.stripe.com https://*.public.blob.vercel-storage.com https://*.blob.vercel-storage.com; frame-src 'self' https://js.stripe.com https://checkout.stripe.com https://billing.stripe.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-write=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/kippa-alternative",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/credit-book-app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ng/kippa-alternative",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ng/credit-book-app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/help",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
